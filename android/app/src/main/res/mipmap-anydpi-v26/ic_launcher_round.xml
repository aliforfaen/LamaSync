<?xml version="1.0" encoding="utf-8"?>
<!-- LAMA-329 phase 6: the `<monochrome>` layer is what Android 13+ tints for
     themed icons. Derived from the foreground's own alpha on the same 108dp
     canvas, so it aligns exactly; see the brand README for the recipe. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/lama_courier_launcher" />
    <monochrome android:drawable="@drawable/lama_courier_monochrome" />
</adaptive-icon>
