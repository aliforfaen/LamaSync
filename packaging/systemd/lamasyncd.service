[Unit]
Description=LamaSync Daemon
Documentation=https://github.com/aliforfaen/LamaSync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h expands to $HOME for the user running the service
# ExecStartPre runs a non-blocking update check before the daemon starts.
# The leading `-` tells systemd to ignore the exit code so an offline or
# rate-limited GitHub API never blocks daemon startup.
ExecStartPre=-%h/.local/bin/lamasyncd --check-update
ExecStart=%h/.local/bin/lamasyncd
# Future-proofing: SIGHUP triggers a config reload. Keep this line even when
# the daemon doesn't yet wire the signal — systemd will accept it as a no-op
# until the handler lands.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
# Logs to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamasyncd
# Hardening (relaxed for development; tighten in production)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# ReadWritePaths lists the directories and socket files the daemon needs
# to write. Paths must be absolute (systemd does not expand %h here) and
# must NOT live under $HOME itself, because ProtectHome=read-only blanks
# the whole tree. The socket defaults to $XDG_RUNTIME_DIR/lamasync.sock
# (=/run/user/<uid>/lamasync.sock); /run/user must be explicitly
# whitelisted or the bind fails with EROFS. If the socket falls back to
# ~/.lamasync/lamasync.sock (no XDG_RUNTIME_DIR — e.g. root containers,
# old shells), %h/.lamasync covers it. Add custom project mount roots
# here, e.g.:
#   ReadWritePaths=%h/.config/lamasync %h/.local/share/lamasync %h/.cache/lamasync %h/.lamasync %h/projects /run/user/%U
ReadWritePaths=%h/.config/lamasync %h/.local/share/lamasync %h/.cache/lamasync %h/.lamasync %h/projects /run/user/%U
# Standardize socket path so the daemon, TUI, and per-mount units agree.
# `$XDG_RUNTIME_DIR` expands to /run/user/<uid> at runtime under
# systemd --user; matches the default in @lamasync/core's socket-path
# helper. client.toml's `socketPath` overrides this when set.
Environment=LAMASYNC_SOCKET_PATH=${XDG_RUNTIME_DIR}/lamasync.sock
# systemd user services inherit a minimal PATH from the user manager
# (/usr/local/bin:/usr/bin) regardless of what `systemctl --user show-environment`
# shows. Set PATH explicitly so user-installed binaries (rclone at
# ~/.local/bin, bun at ~/.bun/bin, restic via package manager, etc.) are
# visible to the daemon. `%h` works for /root and every non-/home home.
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin
# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=default.target
